# -----------------------------------------------------------------------------
# Listings backend
#
# Use "firestore" for the final project and team demos.
# Use "local" only for offline development/testing without Firebase.
# -----------------------------------------------------------------------------
VITE_LISTINGS_BACKEND=firestore

# -----------------------------------------------------------------------------
# Firebase Configuration
#
# Copy this file to .env and replace the placeholder values with your Firebase
# project's configuration.
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-auth-domain
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-storage-bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Optional (used for Firebase Analytics)
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id